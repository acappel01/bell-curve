# Base URL of the prx-backend API (no trailing slash).
API_BASE_URL=https://your-backend.example.com/api/v1

# Optional: ApiClient bearer token issued in the backend admin (API Clients section).
# Public content reads work without one; set it when the install locks origins
# or when calling authenticated endpoints server-side.
API_TOKEN=

# LOCAL DEV against a backend with an mkcert-issued cert: run `npm run dev:local`
# (uses NODE_OPTIONS=--use-system-ca so Node trusts the OS trust store, where
# `mkcert -install` placed the root CA). Node only reads that option at startup,
# so it cannot live in this file. Never disable TLS verification.

# Fetch-cache window in seconds. 0 = always fresh (recommended for local dev);
# unset defaults to 300 for production.
API_REVALIDATE=0

# NEXT_PUBLIC_API_BASE_URL is GONE, deliberately. Browser API calls used to go
# straight to the backend over a public base URL, which is why the backend had
# to stay open: a browser cannot hold a secret, so the bundle could never send
# a token. They now go to this app's own origin at /api/backend, which forwards
# them upstream with the server-side API_TOKEN attached and only for the exact
# method + path pairs on the allowlist in lib/backendProxy.js.
#
# Nothing browser-side needs configuring any more. If you are restoring an old
# .env, drop the line rather than re-adding it — it is read by nothing, and the
# backend origin is no longer exposed to the client bundle at all.

# Shared secret for the on-demand revalidation webhook (POST /api/revalidate).
# Must match CMS_FRONTEND_REVALIDATE_SECRET on the backend. Unset = disabled.
REVALIDATE_SECRET=

# Public origin this site is served from, no trailing slash. Server-side only.
# Used for canonical URLs, JSON-LD, robots.txt and the sitemap. Unset = no
# canonicals and an empty sitemap (deliberate — a guessed origin is worse).
SITE_URL=https://your-site.example.com
