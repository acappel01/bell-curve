# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
/.idea
!.env.example

# AI assistant workspaces and instruction files — local tooling, not product.
# Kept local so Atlas-specific frontend context never reaches a shared repo.
/.claude/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
AGENT.md

# Localized Docs
/docs
# Headless screenshot output (scripts/shot.mjs) — local verification artifacts.
.screenshots/

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — credentials are database-driven and server-side. Nothing secret
# belongs in git. .env.example is the only tracked env file (placeholders only).
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
env.local
.envrc
*.pem
*.key
*.p8
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
service-account*.json
secrets.*
*.sql
*.sql.gz
*.dump
backup*.tar*

