            "absorb": [
                "aod-9604"
            ]
        },
        {
            "primary": "5 amino 1-mq",
            "absorb": [
                "5 amino 1mq"
            ]
        },
        {
            "primary": "mgf",
            "absorb": [
                "mechano-growth-factor"
            ]
        },
        {
            "primary": "b6",
            "absorb": [
                "pyridoxine"
            ]
        }
    ],
