{
  "_note": "Flexible section types for the BCH homepage, in the backend's FlexibleSectionType shape (name, slug, description, icon, schema.fields). Seeder input once Amy approves the layout. Code blueprint additions are listed under blueprint_additions.",
  "types": [
    {
      "name": "BCH trust strip",
      "slug": "bch-trust-strip",
      "icon": "heroicon-o-check-badge",
      "description": "Row of linked labels: the three-part strip under the homepage hero, topic navigation (with a heading) or a closing set of routes.",
      "schema": {
        "fields": [
          {
            "key": "heading",
            "label": "Heading (optional)",
            "kind": "text"
          },
          {
            "key": "items",
            "label": "Items",
            "kind": "repeater",
            "max": 6,
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "kind": "text",
                "required": true,
                "max": 60
              },
              {
                "key": "url",
                "label": "Link URL",
                "kind": "text"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "BCH Health Map teaser",
      "slug": "bch-health-map-teaser",
      "icon": "heroicon-o-map",
      "description": "Health Map invitation: image, copy, CTA and a card of named pathways. No scores.",
      "schema": {
        "fields": [
          {
            "key": "heading",
            "label": "Heading",
            "kind": "text",
            "required": true
          },
          {
            "key": "emphasis",
            "label": "Italic emphasis",
            "kind": "text"
          },
          {
            "key": "body",
            "label": "Body",
            "kind": "textarea"
          },
          {
            "key": "cta",
            "label": "CTA",
            "kind": "cta"
          },
          {
            "key": "image",
            "label": "Image",
            "kind": "image"
          },
          {
            "key": "side_note",
            "label": "Side note",
            "kind": "textarea",
            "help": "Short stacked note; each line on its own row."
          },
          {
            "key": "card_title",
            "label": "Card title",
            "kind": "text"
          },
          {
            "key": "card_caption",
            "label": "Card caption",
            "kind": "textarea"
          },
          {
            "key": "categories",
            "label": "Pathways",
            "kind": "repeater",
            "max": 6,
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "kind": "text",
                "required": true
              }
            ]
          }
        ]
      }
    },
    {
      "name": "BCH statement band",
      "slug": "bch-statement",
      "icon": "heroicon-o-chat-bubble-bottom-center-text",
      "description": "Charcoal band with one large statement and a side note.",
      "schema": {
        "fields": [
          {
            "key": "heading",
            "label": "Heading",
            "kind": "text",
            "required": true
          },
          {
            "key": "emphasis",
            "label": "Italic emphasis",
            "kind": "text"
          },
          {
            "key": "side_note",
            "label": "Side note",
            "kind": "textarea"
          }
        ]
      }
    },
    {
      "name": "BCH paths",
      "slug": "bch-paths",
      "icon": "heroicon-o-squares-2x2",
      "description": "Three asymmetric cards (Care, Shop, Guidance) and one CTA.",
      "schema": {
        "fields": [
          {
            "key": "heading",
            "label": "Heading",
            "kind": "text",
            "required": true
          },
          {
            "key": "emphasis",
            "label": "Italic emphasis",
            "kind": "text"
          },
          {
            "key": "items",
            "label": "Cards",
            "kind": "repeater",
            "max": 3,
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "kind": "text",
                "required": true
              },
              {
                "key": "body",
                "label": "Body",
                "kind": "textarea"
              },
              {
                "key": "url",
                "label": "Link URL",
                "kind": "text"
              },
              {
                "key": "image",
                "label": "Image",
                "kind": "image"
              }
            ]
          },
          {
            "key": "cta",
            "label": "CTA",
            "kind": "cta"
          }
        ]
      }
    },
    {
      "name": "BCH article row",
      "slug": "bch-article-row",
      "icon": "heroicon-o-newspaper",
      "description": "Featured article plus two. Posts render only when published.",
      "schema": {
        "fields": [
          {
            "key": "heading",
            "label": "Heading",
            "kind": "text"
          },
          {
            "key": "link_label",
            "label": "Library link label",
            "kind": "text"
          },
          {
            "key": "link_url",
            "label": "Library link URL",
            "kind": "text"
          },
          {
            "key": "posts",
            "label": "Posts",
            "kind": "repeater",
            "max": 3,
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "kind": "text",
                "required": true
              },
              {
                "key": "url",
                "label": "Link URL",
                "kind": "text"
              },
              {
                "key": "published",
                "label": "Published",
                "kind": "boolean",
                "default": false
              },
              {
                "key": "image",
                "label": "Image",
                "kind": "image"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "BCH founder",
      "slug": "bch-founder",
      "icon": "heroicon-o-user",
      "description": "Founder letter strip: contained portrait, excerpt, side note and link.",
      "schema": {
        "fields": [
          {
            "key": "heading",
            "label": "Heading",
            "kind": "text",
            "required": true
          },
          {
            "key": "emphasis",
            "label": "Italic emphasis",
            "kind": "text"
          },
          {
            "key": "body",
            "label": "Excerpt",
            "kind": "textarea"
          },
          {
            "key": "image",
            "label": "Portrait",
            "kind": "image",
            "help": "Horizontal crop; never a tight headshot."
          },
          {
            "key": "side_note",
            "label": "Side note",
            "kind": "textarea"
          },
          {
            "key": "cta",
            "label": "CTA",
            "kind": "cta"
          }
        ]
      }
    },
    {
      "name": "BCH waitlist",
      "slug": "bch-waitlist",
      "icon": "heroicon-o-envelope",
      "description": "Waitlist / notify-me form for a service that isn't live. Name, email, optional state and non-sensitive interest; no health information.",
      "schema": {
        "fields": [
          {
            "key": "eyebrow",
            "label": "Eyebrow",
            "kind": "text"
          },
          {
            "key": "heading",
            "label": "Heading",
            "kind": "text",
            "required": true
          },
          {
            "key": "emphasis",
            "label": "Italic emphasis",
            "kind": "text"
          },
          {
            "key": "body",
            "label": "Intro",
            "kind": "textarea"
          },
          {
            "key": "service",
            "label": "Service",
            "kind": "select",
            "options": [
              {
                "value": "care",
                "label": "Care"
              },
              {
                "value": "shop",
                "label": "Shop"
              },
              {
                "value": "membership",
                "label": "Membership"
              }
            ],
            "required": true
          },
          {
            "key": "ask_state",
            "label": "Ask for state",
            "kind": "boolean",
            "default": true
          },
          {
            "key": "interest_options",
            "label": "Interest options",
            "kind": "repeater",
            "simple": true,
            "fields": [
              {
                "key": "option",
                "label": "Option",
                "kind": "text"
              }
            ],
            "help": "Non-sensitive choices only. Never symptoms, diagnoses or medications."
          },
          {
            "key": "consent_label",
            "label": "Marketing consent label",
            "kind": "text",
            "help": "Rendered unticked and optional."
          },
          {
            "key": "submit_label",
            "label": "Button label",
            "kind": "text"
          },
          {
            "key": "success_message",
            "label": "Success message",
            "kind": "textarea"
          },
          {
            "key": "privacy_note",
            "label": "Privacy note",
            "kind": "text"
          }
        ]
      }
    }
  ],
  "blueprint_additions": {
    "hero": [
      "layout option 'split' (contained image beside copy; type-led when no image)",
      "image_shape (select: corner | arch | organic)",
      "service (select: care | shop | membership): primary CTA and status line from config services",
      "background_image_mobile (image)",
      "background_video {url, type}",
      "microcopy_link_label",
      "microcopy_link_url"
    ],
    "image-text-split": [
      "image_shape (select: none | organic | arch)",
      "side_note (textarea)"
    ],
    "cta-banner": [
      "emphasis (text)",
      "service (select): primary CTA from config services"
    ],
    "how-it-works": [
      "image (image, optional, beside the steps)",
      "theme (select: white | ivory)"
    ],
    "features-grid": [
      "emphasis (text)",
      "theme (select: white | ivory | blush)",
      "features[].eyebrow",
      "features[].cta_label",
      "features[].cta_url",
      "cta_label / cta_url (section CTA)"
    ],
    "text-block": [
      "emphasis (text)",
      "link_label",
      "link_url"
    ],
    "pricing-tiers": [
      "heading",
      "emphasis",
      "lead",
      "service (select): card CTA when a card has none",
      "footnote (richtext)"
    ],
    "faq": [
      "(no change; rendered by the BCH FAQ component)"
    ],
    "testimonials": [
      "(no change; stars, images and rating_stats are not rendered for BCH)"
    ]
  },
  "config_additions": {
    "services": "{care|shop|membership}: { state: live|waitlist|coming_soon, actions: { <state>: { label, url, status? } } }. Admin flips state; every CTA for that service follows."
  },
  "endpoint_additions": {
    "POST /api/v1/waitlist": "{ service, first_name, email, state?, interest?, marketing_consent } -> 201. No health data. Used by bch-waitlist."
  }
}
